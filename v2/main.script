
    class Elm2BaseElement extends HTMLElement {
    upgradeElement(tagName, className) {
        if (this.querySelector(`:scope > ${tagName}.${className}`)) return;

        const inner = document.createElement(tagName);
        inner.classList.add(className);
        
        const children = Array.from(this.childNodes);
        this.syncAttributes(this, inner);
        
        // 子要素（テキスト等）を一旦内部要素へ移動
        children.forEach(child => {
            inner.appendChild(child);
        });
        
        this.appendChild(inner);

        // 属性の変更を監視して同期
        const observer = new MutationObserver(() => this.syncAttributes(this, inner));
        observer.observe(this, { attributes: true });
        
        return inner;
    }

    syncAttributes(source, target) {
        Array.from(source.attributes).forEach(attr => {
            if (attr.name !== 'class') {
                target.setAttribute(attr.name, attr.value);
            }
        });
    }
}

/**
 * corner-shape のサポート判定
 */
function checkCornerShapeSupport() {
    const testEl = document.createElement('div');
    const props = ['corner-shape', '-webkit-corner-shape', 'border-corner-shape'];
    
    const isSupported = props.some(prop => {
        testEl.style[prop] = 'super-ellipse';
        return testEl.style[prop] !== '';
    });

    if (!isSupported) {
        document.documentElement.style.setProperty('--elm2-corner-superellipse', '1');
        console.log('corner-shape: Not Supported');
    } 
}

/**
 * コンポーネント定義: ボタン
 */
function elm2Button() {
    class Elm2Button extends Elm2BaseElement {
        connectedCallback() {
            this.upgradeElement('button', 'elm2');
        }
    }
    if (!customElements.get('elm2-button')) {
        customElements.define('elm2-button', Elm2Button);
    }
}
/**
 * elm2 Snackbar Manager
 * 単一インスタンス管理
 */
const Elm2Snackbar = (() => {
    let snackbarEl = null;
    let hideTimer = null;

    function createSnackbar() {
        if (snackbarEl) {
            console.log('[elm2-snackbar] 既存Snackbarを再利用');
            return snackbarEl;
        }

        snackbarEl = document.createElement('div');
        snackbarEl.className = 'elm2-snackbar-container';

        const messageEl = document.createElement('span');
        messageEl.className = 'elm2-snackbar-message';

        const closeBtn = document.createElement('button');
        closeBtn.className = 'elm2-snackbar-close';
        closeBtn.type = 'button';
        closeBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="#FFFFFF"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>';
        closeBtn.addEventListener('click', () => {
            console.log('[elm2-snackbar] 閉じるボタン押下');
            hide(true);
        });

        snackbarEl.appendChild(messageEl);
        snackbarEl.appendChild(closeBtn);

        document.body.appendChild(snackbarEl);
        console.log('[elm2-snackbar] Snackbar生成完了', snackbarEl);

        return snackbarEl;
    }
function show(message, duration = 3000, bgColor = null) {
    if (!message) {
        console.warn('[elm2-snackbar] messageが空です');
        return;
    }

    const el = createSnackbar();
    if (!el) {
        console.error('[elm2-snackbar] Snackbar要素取得失敗');
        return;
    }

    const messageEl = el.querySelector('.elm2-snackbar-message');
    if (!messageEl) {
        console.error('[elm2-snackbar] message要素が存在しません');
        return;
    }

    messageEl.textContent = message;

    if (bgColor) {
        const resolvedBg = bgColor.startsWith('--') ? `var(${bgColor})` : bgColor;
        el.style.backgroundColor = resolvedBg;
    } else {
        el.style.backgroundColor = '';
    }

    // --- 修正ポイント：表示処理 ---
    // すでに表示されている場合はタイマー更新のみ、
    // 新規（または非表示状態）の場合は少し待ってからクラスを付与
    if (el.classList.contains('is-visible')) {
        console.log('[elm2-snackbar] 更新:', message);
    } else {
        // 1ms〜10ms程度の待機を入れることで、ブラウザに「描画準備」をさせる
        setTimeout(() => {
            el.classList.add('is-visible');
            console.log('[elm2-snackbar] 表示開始:', message);
        }, 10); 
    }

    if (hideTimer) {
        clearTimeout(hideTimer);
    }

    hideTimer = setTimeout(hide, duration);
}

    function hide(force = false) {
        if (!snackbarEl) {
            console.warn('[elm2-snackbar] 非表示対象が存在しません');
            return;
        }

        snackbarEl.classList.remove('is-visible');
        console.log('[elm2-snackbar] 非表示', force ? '(強制)' : '');

        if (hideTimer) {
            clearTimeout(hideTimer);
            hideTimer = null;
            console.log('[elm2-snackbar] タイマー解除完了');
        }
    }

    return {
        show,
        hide
    };
})();

function initElm2SnackbarButtons() {
    const buttons = document.querySelectorAll('elm2-button');

    if (!buttons || buttons.length === 0) {
        console.error('[elm2-snackbar] elm2-button が取得できません');
        return;
    }

    buttons.forEach(btn => {
        if (!btn) {
            console.warn('[elm2-snackbar] null要素を検出、スキップ');
            return;
        }

        const innerButton = btn.querySelector('button.elm2');

        if (!innerButton) {
            console.warn('[elm2-snackbar] 内部buttonが存在しません', btn);
            return;
        }

        innerButton.addEventListener('click', () => {
            const message = btn.getAttribute('snackbar');
            const bgColor = btn.getAttribute('bg');

            if (!message) {
                console.log('[elm2-snackbar] snackbar属性なし、スキップ');
                return;
            }

            Elm2Snackbar.show(message, 3000, bgColor);
        });

        console.log('[elm2-snackbar] clickイベント登録完了', innerButton);
    });
}



/**
 * コンポーネント定義: インプット (新規)
 */
function elm2Input() {
    class Elm2Input extends Elm2BaseElement {
        connectedCallback() {
            // 内部に input 要素を作成
            const innerInput = this.upgradeElement('input', 'elm2');
            
            // --- オートコンプリートをオフにする設定 ---
            innerInput.setAttribute('autocomplete', 'off');
            
            // <elm2-input>の中身のテキストを placeholder に変換する
            const textContent = innerInput.textContent.trim();
            if (textContent && !innerInput.hasAttribute('placeholder')) {
                innerInput.setAttribute('placeholder', textContent);
                innerInput.textContent = ''; // 内部のテキストノードをクリア
            }
        }
    }
    if (!customElements.get('elm2-input')) {
        customElements.define('elm2-input', Elm2Input);
    }
}

/**
 * カルーセルの初期化
 */
function initElm2Carousels() {
    const carousels = document.querySelectorAll('elm2-carousel');
    carousels.forEach((el) => {
        el.classList.add('elm2');
    });
}

/**
 * コンポーネント定義: リスト（UL）
 */
function elm2ListUl() {
    class Elm2ListUl extends Elm2BaseElement {
        connectedCallback() {
            console.log('[elm2-list-ul] connected');

            const container = this.upgradeElement('div', 'elm2-list-container');

            if (!container) {
                console.error('[elm2-list-ul] container生成失敗');
                return;
            }

            container.classList.add('elm2');
            console.log('[elm2-list-ul] container生成成功', container);
        }
    }

    if (!customElements.get('elm2-list-ul')) {
        customElements.define('elm2-list-ul', Elm2ListUl);
        console.log('[elm2-list-ul] custom element 定義完了');
    }
}

/**
 * コンポーネント定義: スイッチ (Checkboxベース)
 */
function elm2Switch() {
    class Elm2Switch extends Elm2BaseElement {
        connectedCallback() {
            // 内部に input 要素を作成
            const inner = this.upgradeElement('input', 'elm2-switch-inner');
            inner.type = 'checkbox';

            // JSから直接 .checked でアクセスできるようにプロパティを定義
            Object.defineProperty(this, 'checked', {
                get: () => inner.checked,
                set: (val) => { inner.checked = val; },
                configurable: true
            });

            // .value も同様にブリッジ
            Object.defineProperty(this, 'value', {
                get: () => inner.value,
                set: (val) => { inner.value = val; },
                configurable: true
            });
        }
    }

    if (!customElements.get('elm2-switch')) {
        customElements.define('elm2-switch', Elm2Switch);
    }
}


/**
 * コンポーネント定義: バトル (投票表示)
 */
function elm2Battle() {
    class Elm2Battle extends Elm2BaseElement {
        connectedCallback() {
            // 内部コンテナを作成
            const container = this.upgradeElement('div', 'elm2-battle-container');
            const valueAttr = this.getAttribute('value') || "0,0";
            const values = valueAttr.split(',').map(v => parseInt(v.trim(), 10) || 0);
            const total = values.reduce((a, b) => a + b, 0);
            
            // 元々のテキスト（「の投票」など）を取得
            const suffix = this.getAttribute('text') || "";

            // 既存の内容をクリアして構造を再構築
            container.innerHTML = '';

            values.forEach(v => {
                const percent = total > 0 ? Math.round((v / total) * 100) : 0;
                
                const item = document.createElement('div');
                item.style.setProperty('--value', percent);
                
                const percentEl = document.createElement('div');
                percentEl.textContent = `${percent}%`;
                
                const labelEl = document.createElement('div');
                labelEl.textContent = `${v}${suffix}`;
                
                item.appendChild(percentEl);
                item.appendChild(labelEl);
                container.appendChild(item);
            });
        }
    }

    if (!customElements.get('elm2-battle')) {
        customElements.define('elm2-battle', Elm2Battle);
    }
}

// initElm2Components 内に elm2Battle(); を追加してください

/**
 * 全コンポーネントの初期化実行
 */
function initElm2Components() {
    checkCornerShapeSupport();
    elm2Button();
    elm2Input();
    elm2ListUl();
    initElm2Carousels();
    initElm2SnackbarButtons();
    elm2Switch();
    elm2Battle(); // ←これを追加

    console.log('全コンポーネント初期化完了');
}


// 実行
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initElm2Components);
} else {
    initElm2Components();
}
